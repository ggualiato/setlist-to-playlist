# Copy to apps/api/.env and fill in. Never commit real values.

# --- API server ---
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# Origin the browser uses to reach the app (Vite dev server). Must be 127.0.0.1, NOT localhost:
# Spotify rejects localhost redirect URIs and cookies are host-scoped.
WEB_ORIGIN=http://127.0.0.1:5173

# --- Setlist.fm (https://api.setlist.fm/docs/1.0/index.html) ---
SETLISTFM_API_KEY=

# --- Spotify (https://developer.spotify.com/dashboard) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must be registered EXACTLY in the Spotify dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback
