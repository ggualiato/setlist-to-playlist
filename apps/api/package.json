{
  "name": "@setlist/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "import:setlist": "tsx --env-file-if-exists=.env src/scripts/import-setlist.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@setlist/shared": "workspace:*",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
